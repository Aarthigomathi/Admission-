# Copy this file to .env in the backend folder before running Spring Boot.
SERVER_PORT=8080

# Local development database: persistent H2 file database in backend/data/.
DB_URL=jdbc:h2:file:./data/tn_colleges;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
H2_CONSOLE_ENABLED=true
SHOW_SQL=false

# Development-only signing key. Generate a new strong Base64 key for deployment.
APP_JWT_SECRET=5367566B59703373367639792F423F4528482B4D6251655468576D5A71347437
JWT_EXPIRATION_MS=86400000
APP_LOG_LEVEL=INFO
